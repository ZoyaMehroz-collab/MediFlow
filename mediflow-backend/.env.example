# MEDIFLOW Environment Configuration Example

# Server Configuration
PORT=8080

# Database Configuration (MySQL 8)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mediflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_USERNAME=mediflow_user
SPRING_DATASOURCE_PASSWORD=secure_password_123
SPRING_JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Security Configuration
